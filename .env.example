# ==============================================================================
# DetectAI Environment Configuration
# ==============================================================================

# Database Configuration:
# - Leave empty to use local SQLite (detectai.db) automatically.
# - Or set to your Supabase / PostgreSQL URI for permanent cloud storage:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Primary AI Provider: Google Gemini
# Get key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary AI Provider: xAI Grok (Automatic failover if Gemini fails or 503s)
# Get key at: https://console.x.ai
GROK_API_KEY=your_grok_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
