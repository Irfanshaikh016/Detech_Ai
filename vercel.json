{
  "buildCommand": "pip install -r backend/requirements.txt && pip install -r frontend/requirements.txt",
  "outputDirectory": ".",
  "functions": {
    "api/backend.py": {
      "maxDuration": 300,
      "memory": 3008,
      "runtime": "python3.9"
    }
  },
  "env": {
    "GEMINI_API_KEY": "@GEMINI_API_KEY",
    "BACKEND_URL": "@BACKEND_URL"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/backend.py"
    },
    {
      "source": "/health",
      "destination": "/api/backend.py"
    }
  ]
}
