{
  "buildCommand": "pip install -r requirements.txt && pip install -r frontend/requirements.txt",
  "outputDirectory": ".",
  "functions": {
    "api/backend.py": {
      "maxDuration": 120,
      "memory": 3008
    },
    "api/streamlit.py": {
      "maxDuration": 120,
      "memory": 3008
    }
  },
  "env": {
    "GEMINI_API_KEY": "@gemini_api_key",
    "BACKEND_URL": "@backend_url"
  }
}
